{
    "name": "codevibes-backend",
    "version": "1.0.0",
    "description": "CodeVibes - Open-source code analysis API using DeepSeek v3",
    "main": "dist/server.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "lint": "eslint src",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@octokit/rest": "^20.0.2",
        "better-sqlite3": "^12.5.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.22.2",
        "express-rate-limit": "^7.1.5",
        "jsonwebtoken": "^9.0.3",
        "minimatch": "^9.0.9",
        "tiktoken": "^1.0.12",
        "uuid": "^13.0.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.32.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.0.0",
        "@types/uuid": "^10.0.0",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^9.32.0",
        "eslint-plugin-import-x": "^4.17.1",
        "globals": "^15.15.0",
        "tsx": "^4.7.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.67.0",
        "vitest": "^4.1.11"
    },
    "engines": {
        "node": "^22.0.0 || >=24.0.0"
    },
    "overrides": {
        "body-parser": "1.20.6",
        "qs": "6.15.3",
        "path-to-regexp@0.1": "0.1.13",
        "minimatch@3": "3.1.5",
        "brace-expansion@1": "1.1.18",
        "brace-expansion@2": "2.1.4"
    }
}
