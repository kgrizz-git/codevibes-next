  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p codevibes-backend/tsconfig.json",
    "prepare": "husky",
    "preview": "vite preview",
    "test": "vitest run",
    "lint:frontend": "eslint .",
    "lint:backend": "npm --prefix codevibes-backend run lint",
    "lint:all": "npm run lint:frontend && npm run lint:backend",
    "test:frontend": "vitest run",
    "test:backend": "npm --prefix codevibes-backend run test",
    "test:all": "npm run test:frontend && npm run test:backend",
    "test:frontend:coverage": "vitest run --coverage",
    "test:backend:coverage": "npm --prefix codevibes-backend run test:coverage",
    "test:all:coverage": "npm run test:frontend:coverage && npm run test:backend:coverage",
    "build:frontend": "vite build",
    "build:backend": "npm --prefix codevibes-backend run build",
    "build:all": "npm run build:frontend && npm run build:backend",
    "repo:map": "node scripts/repo-map.mjs",
    "docs:pipeline-contract": "node scripts/review-pipeline-contract.mjs --write",
    "check:pipeline-contract": "node scripts/review-pipeline-contract.mjs --check",
    "check:pipeline-docs": "node scripts/check-review-pipeline-docs.mjs",
    "check:structure": "node scripts/check-file-size.mjs",
    "check:structure:advisory": "node scripts/check-file-size.mjs --advisory",
    "check:complexity": "node scripts/check-complexity-budget.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:doc-links": "node scripts/check-doc-links.mjs --strict",
    "check:guidance": "node scripts/check-guidance.mjs --strict",
    "check:guidance:advisory": "node scripts/check-guidance.mjs",
    "check:fast": "npm run lint:all && npm run typecheck && node scripts/test-affected.mjs",
    "check:all": "npm run lint:all && npm run typecheck && npm run test:all:coverage && npm run build:all && npm run check:doc-links && npm run check:guidance && npm run check:pipeline-contract && npm run check:pipeline-docs && npm run check:structure && npm run check:complexity && npm run check:bundle-size",
    "ci": "npm run check:all"
  },
